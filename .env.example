# WebRTC Signaling Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# STUN and TURN Servers for NAT traversal
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN servers (for restrictive networks)
# Format: turn:server:port?transport=udp
TURN_SERVERS=

# WebSocket Configuration
WS_PATH=/ws
WS_READ_BUFFER=1024
WS_WRITE_BUFFER=1024
WS_MAX_CONNECTIONS=1000

# Media Configuration
AUDIO_ENABLED=true
VIDEO_ENABLED=true
VIDEO_CODEC=VP8
AUDIO_CODEC=OPUS

# Room Configuration
MAX_PEERS_PER_ROOM=100
DEFAULT_ROOM_TIMEOUT=3600
ALLOW_ANONYMOUS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
